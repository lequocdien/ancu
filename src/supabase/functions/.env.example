# Mẫu env cho Edge Function send-push. Copy thành functions/.env (đã ignore, KHÔNG commit key thật).
# Cloud: đặt bằng `supabase secrets set --env-file supabase/functions/.env` (SUPABASE_URL /
# SUPABASE_SERVICE_ROLE_KEY do runtime cấp sẵn, không cần đặt).

# Phải khớp Vault `send_push_webhook_secret` (trigger notifications_send_push gửi trong header x-webhook-secret).
PUSH_WEBHOOK_SECRET=local-dev-push-secret

# APNs token-based auth (Apple Developer → Keys → Apple Push Notifications service).
# Để trống APNS_KEY_P8 → dry-run: không gọi APNs, chỉ log + trả số token sẽ gửi.
# Nội dung file AuthKey_XXXXXXXXXX.p8 (PEM); một dòng thì thay xuống dòng bằng \n.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=vn.ancu.app
