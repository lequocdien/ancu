// Copy thành Secrets-Debug.xcconfig / Secrets-Release.xcconfig cùng thư mục (đã gitignore).
//
// - Chỉ dùng key PUBLISHABLE (sb_publishable_…) hoặc anon JWT cũ. App từ chối sb_secret_… / service_role.
// - Trong xcconfig, "//" bắt đầu comment → viết URL bằng mẹo "$()": https:/$()/<ref>.supabase.co

ANCU_SUPABASE_URL = https:/$()/your-project-ref.supabase.co
ANCU_SUPABASE_KEY = sb_publishable_xxxxxxxxxxxxxxxx
// Bật khi đã cấu hình provider trên Supabase + có capability Sign in with Apple:
// ANCU_AUTH_PROVIDERS = apple,google,facebook
